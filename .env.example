##############################################################
# .env — personal overrides and secrets
#
# Copy this file to .env and fill in your values.
# Non-secret defaults live in .envrc (loaded automatically
# by direnv). Only put secrets and personal overrides here.
#
# See docs/authentication.md for how to obtain these. It matters
# that CLIENT_ID is NOT the USER_ID and CLIENT_SECRET is NOT the
# ACCESS_TOKEN — they are two different pairs:
#   * the CLIENT pair identifies your application
#   * the ACCESS_TOKEN / USER_ID pair identifies your grant to it
##############################################################


#########################################
# Required by polarexport — written by `polarexport auth`
#########################################

# Bearer token from the OAuth exchange (POST https://polarremote.com/v2/oauth2/token)
POLAR_ACCESS_TOKEN=<your-polar-access-token>

# The "x_user_id" field returned alongside that access token
POLAR_USER_ID=<your-polar-user-id>


#########################################
# Inputs to `polarexport auth` (or the manual flow)
#########################################

# Credentials tab at https://admin.polaraccesslink.com
POLAR_CLIENT_ID=<your-polar-client-id>
POLAR_CLIENT_SECRET=<your-polar-client-secret>

# Must match the redirect URI registered for your client
POLAR_REDIRECT_URI=http://localhost:8000/auth/polar/callback


#########################################
# Personal overrides (optional)
#########################################

# Relocate the accumulating payload store or the archive output directory:
# POLAREXPORT_DATA_DIR=/mnt/backup/polar
# POLAREXPORT_EXPORT_DIR=/mnt/backup/polar-archives

# Number of in-flight requests to the Polar API (1-20):
# POLAREXPORT_EXPORT_CONCURRENCY=5
